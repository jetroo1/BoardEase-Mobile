# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Throwaway web exports used to check a screen, then thrown away. Each one is
# a full bundle of the whole app, so committing them adds hundreds of
# generated files that say nothing about the source.
.expo-*-check/
.expo-*-web/
.expo-*-qc/
firebase-debug.log

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Local AI assistant config (kept out of the repo)
CLAUDE.md
.claude/

# Generated preview (regenerate with: node docs/figma/render.js)
docs/figma/preview.png

# Chapter documents are submitted, not versioned here
docs/report/*.docx
