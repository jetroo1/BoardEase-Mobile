// BoardEase — Firestore security rules
//
// These replace the temporary "test mode" rules that let anyone read and
// write everything and expire after 30 days.
//
// HOW TO APPLY (there is no CLI needed):
//   Firebase console -> Build -> Firestore Database -> Rules tab
//   -> paste this whole file over what is there -> Publish
//
// The idea in one line: everyone signed in can browse listings and reviews,
// people can only touch their own data, and only admins can change listings.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Looks up the signed-in user's role from their users/{uid} document.
    // We call this instead of trusting anything sent from the phone, because
    // the app itself could be modified -- rules are the real gate.
    function isSignedIn() {
      return request.auth != null;
    }

    // Password accounts must confirm ownership of their email before reading
    // listings or writing reviews/favorites. Federated providers authenticate
    // identity through their provider and do not use Firebase email links.
    function isVerifiedAccount() {
      return isSignedIn()
             && (request.auth.token.email_verified == true
                 || request.auth.token.firebase.sign_in_provider != 'password');
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    function isValidFilters(filters) {
      return filters is map
             && filters.keys().hasOnly(['maxPrice', 'roomType', 'amenities'])
             && filters.keys().hasAll(['maxPrice', 'roomType', 'amenities'])
             && (filters.maxPrice == null
                 || (filters.maxPrice is number
                     && filters.maxPrice >= 0
                     && filters.maxPrice <= 1000000))
             && (filters.roomType == null
                 || filters.roomType in ['Single', 'Shared', 'Studio'])
             && filters.amenities is list
             && filters.amenities.size() <= 6
             && filters.amenities.hasOnly(
                  ['WiFi', 'CR', 'Parking', 'Aircon', 'Kitchen', 'Laundry']
                );
    }

    function isValidReview(reviewId) {
      return request.resource.data.keys().hasOnly(
               ['propertyId', 'userId', 'userName', 'rating', 'body', 'createdAt']
             )
             && request.resource.data.keys().hasAll(
               ['propertyId', 'userId', 'userName', 'rating', 'body', 'createdAt']
             )
             && request.resource.data.propertyId is string
             && request.resource.data.propertyId.size() > 0
             && request.resource.data.propertyId.size() <= 128
             && request.resource.data.userId == request.auth.uid
             && request.resource.data.userName is string
             && request.resource.data.userName.size() > 0
             && request.resource.data.userName.size() <= 128
             && request.resource.data.rating is int
             && request.resource.data.rating >= 1
             && request.resource.data.rating <= 5
             && request.resource.data.body is string
             && request.resource.data.body.size() > 0
             && request.resource.data.body.size() <= 2000
             && request.resource.data.createdAt is number
             && reviewId == request.resource.data.propertyId + '_' + request.auth.uid
             && exists(/databases/$(database)/documents/properties/$(request.resource.data.propertyId))
             && get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.isApproved == true;
    }

    // ── users ────────────────────────────────────────────────────────────
    // Each person can read and edit only their own profile document
    // (this is also where savedFilters and role live). Admins may read any
    // profile so the admin panel can show who submitted what.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // A new account may create its own document, but may NOT hand itself
      // the admin role -- that has to be set from the Firebase console.
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly(['email', 'role', 'consent'])
                    && request.resource.data.keys().hasAll(['email', 'role', 'consent'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.role == 'tenant'
                    && request.resource.data.consent is map
                    && request.resource.data.consent.keys().hasOnly(
                      ['termsVersion', 'privacyVersion', 'acceptedAt']
                    )
                    && request.resource.data.consent.keys().hasAll(
                      ['termsVersion', 'privacyVersion', 'acceptedAt']
                    )
                    && request.resource.data.consent.termsVersion is string
                    && request.resource.data.consent.privacyVersion is string
                    && request.resource.data.consent.acceptedAt is timestamp;

      // A user can update their own document but can never change their role,
      // and can never rewrite the consent recorded when the account was made.
      //
      // Consent is evidence, not a setting. The Data Privacy Act asks us to be
      // able to show what a person agreed to and when; a record the same
      // person can edit from the client afterwards proves nothing. Every
      // update the application makes to this document is a merge, so the
      // block survives untouched and this comparison passes. Accounts created
      // before consent was recorded have no block on either side, which
      // compares equal, so they are not locked out of their own profile.
      allow update: if isVerifiedAccount()
                    && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.get('consent', null)
                       == resource.data.get('consent', null)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                      ['savedFilters', 'alertsEnabled', 'lastAlertCheck', 'photoURL']
                    )
                    && request.resource.data.get('alertsEnabled', false) is bool
                    && request.resource.data.get('lastAlertCheck', 0) is number
                    // A profile picture is a link to an uploaded image, never
                    // the image itself: a document is capped at 1 MB and an
                    // inlined photograph would both blow that and be re-read
                    // on every sign-in. Required to be https so a stored value
                    // cannot be a javascript: or data: URI that some later
                    // view renders.
                    && (request.resource.data.get('photoURL', null) == null
                      || (request.resource.data.photoURL is string
                          && request.resource.data.photoURL.matches('https://.*')
                          && request.resource.data.photoURL.size() <= 1000))
                    && (request.resource.data.get('savedFilters', null) == null
                      || isValidFilters(request.resource.data.savedFilters));

      allow delete: if false;
    }

    // ── properties (boarding house listings) ─────────────────────────────
    // Anyone signed in can browse listings. Only admins may add, edit,
    // approve, or delete them -- this app has no owner self-publishing.
    match /properties/{propertyId} {
      allow read: if isVerifiedAccount();
      allow create, update, delete: if isVerifiedAccount() && isAdmin();
    }

    // ── reviews ──────────────────────────────────────────────────────────
    // Anyone signed in can read reviews. A person may only post a review
    // under their own user id, and the rating must be a sensible 1-5.
    // People can delete their own review; admins can delete any (moderation).
    match /reviews/{reviewId} {
      allow read: if isVerifiedAccount();

      allow create: if isVerifiedAccount()
                    && isValidReview(reviewId);

      // Reviews are immutable after publication. This prevents a valid review
      // being rewritten into arbitrary content through an update request.
      allow update: if false;
      allow delete: if (isVerifiedAccount() && isAdmin())
                    || (isVerifiedAccount() && resource.data.userId == request.auth.uid);
    }

    // ── favorites ────────────────────────────────────────────────────────
    // Completely private: you can only see and change your own saved list.
    match /favorites/{favoriteId} {
      // Split out from `read`, because a get and a list fail differently here.
      //
      // addFavorite() looks the document up before writing it, and the whole
      // point of that lookup is the case where it does not exist yet. On a
      // missing document `resource` is null, so `resource.data.userId` is an
      // error rather than a comparison, and the read was denied -- which the
      // app reported as a connection problem. Tapping the heart on a listing
      // you had never saved could therefore never work.
      //
      // Allowing a get on a document that does not exist gives nothing away:
      // the id is uid_propertyId, so a user can only ask about their own rows,
      // and the answer is "there is nothing here".
      allow get: if isVerifiedAccount()
                 && (resource == null || resource.data.userId == request.auth.uid);

      // A query, where every matching document really does exist and must
      // belong to whoever is asking.
      allow list: if isVerifiedAccount() && resource.data.userId == request.auth.uid;

      allow delete: if isVerifiedAccount() && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedAccount()
                    && request.resource.data.keys().hasOnly(['userId', 'propertyId', 'createdAt'])
                    && request.resource.data.keys().hasAll(['userId', 'propertyId', 'createdAt'])
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.propertyId is string
                    && request.resource.data.propertyId.size() > 0
                    && request.resource.data.propertyId.size() <= 128
                    && request.resource.data.createdAt is number
                    && favoriteId == request.auth.uid + '_' + request.resource.data.propertyId
                    && exists(/databases/$(database)/documents/properties/$(request.resource.data.propertyId));
      allow update: if false;
    }

    // Anything not listed above is denied by default.
  }
}
