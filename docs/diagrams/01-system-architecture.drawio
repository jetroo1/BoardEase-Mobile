        <!-- Explanatory note -->
        <mxCell id="note-webview" value="&lt;b&gt;Why a WebView for the map?&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#55697A&quot; style=&quot;font-size:11px&quot;&gt;Leaflet is a library written for web browsers. React Native has no browser, so the app embeds a tiny one,&lt;br&gt;loads Leaflet inside it, and passes markers in and marker taps back out as small messages.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF4F7;strokeColor=#D5E3EA;align=left;verticalAlign=middle;spacingLeft=16;fontSize=14;fontColor=#0D1B26;" vertex="1" parent="1">
